# ==========================================================================
#  7 FIOS TÊXTIL — regras do servidor (Hostinger, LiteSpeed/Apache)
#  Este arquivo vai junto com o site, na mesma pasta do index.html.
#  Ele é oculto: no Gerenciador de Arquivos da Hostinger, ligue
#  "Mostrar arquivos ocultos" para enxergá-lo.
# ==========================================================================

RewriteEngine On

# --------------------------------------------------------------------------
#  ENDEREÇOS DO SITE ANTIGO
#  O site antigo era uma página só, com rotas montadas por JavaScript. Estes
#  nove endereços estão no Google e podem estar em anúncio, cartão e link
#  antigo. Sem estas linhas eles viram erro 404 no dia da troca e você perde
#  a posição que já tinha. O 301 avisa o Google que a página mudou de lugar
#  e passa o histórico para o endereço novo.
# --------------------------------------------------------------------------
RewriteRule ^catalogo/poliamida/?$    /index.html?grupos=poliamida [R=301,L]
RewriteRule ^catalogo/poliester/?$    /index.html?grupos=poliester [R=301,L]
RewriteRule ^catalogo/dry-fit/?$      /index.html?grupos=dryfit [R=301,L]
RewriteRule ^catalogo/estampados/?$   /index.html?grupos=estampados [R=301,L]
RewriteRule ^outros-produtos/?$       /index.html?grupos=aviamentos [R=301,L]
RewriteRule ^catalogo/?$              /index.html [R=301,L]
RewriteRule ^sobre/?$                 /sobre.html [R=301,L]
RewriteRule ^contato/?$               /contato.html [R=301,L]

# --------------------------------------------------------------------------
#  UM ENDEREÇO SÓ PARA CADA PÁGINA
#  Sempre https e sempre sem www. Se o painel da Hostinger já faz isso, estas
#  linhas não atrapalham; só garantem que continue valendo.
# --------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://setefios.com.br%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://setefios.com.br%{REQUEST_URI} [R=301,L]

# --------------------------------------------------------------------------
#  VELOCIDADE
#  As fotos e o vídeo somam quase 70 MB. Cada arquivo tem a data no endereço
#  (?v=...), então trocar a foto muda o endereço e o navegador busca a nova.
#  Por isso dá para mandar guardar por muito tempo sem risco de o cliente
#  ver foto velha.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain \
                                application/javascript application/json \
                                image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
#  ARQUIVOS QUE NÃO SÃO DA VISITA
# --------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
